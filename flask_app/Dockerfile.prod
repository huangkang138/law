FROM python:3.12-slim

# 阿里云 ECS 内网镜像，部署到其他网络前需替换源地址。
RUN sed -i -e "s@deb.debian.org@mirrors.cloud.aliyuncs.com@g" -e "s@security.debian.org@mirrors.cloud.aliyuncs.com@g" /etc/apt/sources.list.d/debian.sources
ENV PIP_INDEX_URL=http://mirrors.cloud.aliyuncs.com/pypi/simple/ \
    PIP_TRUSTED_HOST=mirrors.cloud.aliyuncs.com

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg tesseract-ocr tesseract-ocr-chi-sim && rm -rf /var/lib/apt/lists/*
COPY requirements.prod.txt ./requirements.prod.txt
RUN pip install --no-cache-dir -r requirements.prod.txt
COPY flask_app/ .
RUN mkdir -p uploads logs data/chroma
EXPOSE 8001
CMD ["gunicorn", "--bind", "0.0.0.0:8001", "--workers", "1", "--threads", "8", "--timeout", "180", "app:app"]
